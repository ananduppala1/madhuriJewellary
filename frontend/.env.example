# ─────────────────────────────────────────────────────────────
# Public website environment
#
# WARNING: every VITE_* value is compiled into the JavaScript
# bundle and is readable by anyone who opens DevTools. Only
# genuinely public configuration belongs in this file.
#
# There is no Supabase key, no Cloudinary key and no token here,
# and there must never be one. The website talks only to the
# Backend API, which holds the credentials server-side.
# ─────────────────────────────────────────────────────────────

# Where the Backend API is reachable from the browser.
# Development default (used if unset): http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# Production example:
# VITE_API_BASE_URL=https://api.madhurijewellers.in
