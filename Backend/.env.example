# ─────────────────────────────────────────────────────────────
# Madhuri Jewellers — Backend environment
#
# Copy to `.env` and fill in. Everything in this file is PRIVATE:
# none of it is ever sent to a browser. Do not commit the real .env.
#
# ON VERCEL there is no .env file — `.env` is gitignored and is never
# uploaded. Every variable below that you actually need must be added
# under Project Settings → Environment Variables instead, for the
# Production, Preview and Development environments.
#
# Required on Vercel (the API returns 503 listing them if missing):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
#   CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
#
# Do NOT set PORT on Vercel — the platform owns the socket.
# NODE_ENV is set to "production" by Vercel automatically.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ── Supabase ────────────────────────────────────────────────
# Project Settings → API.
SUPABASE_URL=https://your-project.supabase.co

# PRIVATE (server only). Used for public reads so RLS applies.
# This is Supabase's browser-safe key, but the browser never sees
# it here because the frontends only talk to this API.
SUPABASE_ANON_KEY=

# PRIVATE — bypasses Row Level Security. Never put this in any
# frontend, any VITE_* variable, or any client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary ──────────────────────────────────────────────
# Dashboard → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# PRIVATE — signs uploads and deletions. Server only.
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=madhuri-jewellers

# ── CORS ────────────────────────────────────────────────────
# Only these origins may call the API, and they are matched exactly.
# A trailing slash is stripped, so both forms work.
PUBLIC_FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174

# Optional comma-separated extras. Three forms are accepted:
#
#   exact     https://madhurijewellers.in
#   wildcard  https://*.vercel.app
#             `*` matches one label only, so this allows
#             https://shop-abc123.vercel.app but NOT
#             https://a.b.vercel.app and NOT
#             https://shop.vercel.app.attacker.com
#   open      *
#             Disables the allow-list entirely. Useful for ten
#             minutes while wiring a deployment up; never leave it
#             on — the API logs a warning in production if you do,
#             because credentialed CORS plus an open list means any
#             site can make authenticated calls on a visitor's behalf.
#
# On Vercel the deployment's own URLs (VERCEL_URL, VERCEL_BRANCH_URL,
# VERCEL_PROJECT_PRODUCTION_URL) are allowed automatically — you do
# not need to list the API's own hostname here.
#
# Production example (both frontends plus their preview builds):
#   EXTRA_ALLOWED_ORIGINS=https://*.vercel.app
EXTRA_ALLOWED_ORIGINS=https://*.vercel.app

# ── Session cookies ─────────────────────────────────────────
# Development over http keeps COOKIE_SECURE=false and SameSite=lax.
#
# ON VERCEL, the admin dashboard and this API are on two different
# *.vercel.app hostnames, which browsers treat as cross-site. A
# SameSite=lax cookie is silently dropped there, so admin login
# appears to succeed and then every following request is a 401.
# Both of these are mandatory:
#
#   COOKIE_SECURE=true
#   COOKIE_SAME_SITE=none
#
# Leave COOKIE_DOMAIN UNSET on *.vercel.app. `vercel.app` is on the
# Public Suffix List, so no cookie may be scoped to `.vercel.app` —
# the browser rejects it outright. Host-only cookies on the API's own
# hostname are what you want, and are what you get by leaving this
# blank. Only set COOKIE_DOMAIN once both apps live under one real
# domain you control (e.g. .madhurijewellers.in).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.madhurijewellers.in

# ── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ── Uploads ─────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=8

# ── Redis (server-side cache) ───────────────────────────────
# PRIVATE. REDIS_URL usually carries a password — it is a backend
# secret in exactly the way SUPABASE_SERVICE_ROLE_KEY is, and must
# never appear in any VITE_* variable or frontend bundle.
#
# Redis only makes public reads faster. If it is unset, switched
# off, or unreachable, the API keeps serving live data from
# Supabase — slower, but correct. It is never the source of truth.
#
# Local development:
#   docker run --name madhuri-redis -p 6379:6379 -d redis:7
#
# ON VERCEL a localhost address can never be reached. The API detects
# this and disables the cache with a warning rather than stalling on a
# connect timeout every cold start — but you should either point this
# at a hosted Redis (rediss://…) or set REDIS_ENABLED=false so the
# intent is explicit. Reads then go straight to Supabase, which is
# correct, just slower.
REDIS_URL=redis://localhost:6379

# Managed Redis over TLS — use the rediss:// scheme and TLS is
# configured automatically. No vendor is hardcoded anywhere.
#   REDIS_URL=rediss://default:PASSWORD@your-host.example.com:6380

# Set to false to run with no cache at all (every read hits Supabase).
REDIS_ENABLED=true

# Namespaced per deployment as "<prefix>:<NODE_ENV>:public:…" so a
# staging instance sharing a Redis cannot serve production data.
REDIS_KEY_PREFIX=mj

# How long to wait for the initial connection.
REDIS_CONNECT_TIMEOUT_MS=5000

# A cache lookup that takes longer than this is not worth waiting
# for — the request gives up and reads Supabase instead.
REDIS_COMMAND_TIMEOUT_MS=1000

# Retries per command before falling through to the database.
REDIS_MAX_RETRIES_PER_REQUEST=1

# Ceiling on the reconnect backoff, so an outage cannot spin the CPU.
REDIS_MAX_RECONNECT_DELAY_MS=10000

# Fallback TTL for any entry that does not name its own.
# Per-family TTLs live in src/cache/cache.constants.ts.
REDIS_DEFAULT_TTL_SECONDS=300

# Only ever false against a self-signed certificate in development.
REDIS_TLS_REJECT_UNAUTHORIZED=true

# Populate site settings and the collection list at boot. Off by
# default: cache-aside fills everything else on first request, and
# warming the whole catalogue would hammer Supabase on every deploy.
CACHE_WARM_ON_STARTUP=false

# ── Administrator bootstrap (seed only) ─────────────────────
# Read by `npm run seed` to create the dashboard login, never by
# the running API. Use a long unique password from a manager.
# Remove or blank these once the account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
