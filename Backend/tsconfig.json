{
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "compilerOptions": {
    "target": "ES2022",
    /**
     * NodeNext everywhere — the same resolution the compiled output actually
     * runs under on Node and on Vercel. Relative imports carry an explicit
     * `.js` extension, which is what Node ESM requires and what every other
     * toolchain (tsx, esbuild, Vercel's function builder) understands without
     * special configuration.
     */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false
  }
}
