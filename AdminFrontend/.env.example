# ─────────────────────────────────────────────────────────────
# Admin dashboard environment
#
# Every VITE_* value is visible in the browser bundle. The only
# thing this app needs to know is where the API is.
#
# There is deliberately no Supabase key, no Cloudinary key and
# no admin credential here. Sessions are HTTP-only cookies the
# JavaScript cannot read, issued by the Backend.
# ─────────────────────────────────────────────────────────────

VITE_API_BASE_URL=http://localhost:5000

# Shown behind the sidebar's "View website" link. Public information.
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Production example:
# VITE_API_BASE_URL=https://api.madhurijewellers.in
